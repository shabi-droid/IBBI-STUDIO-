rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'gzainab500@gmail.com')
      );
    }

    function isValidPersonaId(personaId) {
      return personaId in ['friend', 'sibling', 'mentor', 'partner'];
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.dateOfBirth is string && data.dateOfBirth.size() == 10 &&
        data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.age is int && data.age >= 10 && data.age <= 120 &&
        data.isAdult is bool &&
        data.isAdult == (data.age >= 18) &&
        data.currentActivity in ['Studying', 'Working', 'Both', 'Exploring'] &&
        data.studyField is string && data.studyField.size() <= 120 &&
        data.hobbies is list && data.hobbies.size() <= 10 &&
        (data.hobbies.size() == 0 || data.hobbies[0] is string) &&
        data.passwordHash is string && data.passwordHash.size() >= 32 && data.passwordHash.size() <= 256 &&
        data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 128 &&
        data.termsAccepted is bool && data.termsAccepted == true &&
        data.profileCompleted is bool &&
        data.messageCount is int && data.messageCount >= 0 &&
        data.signupDate is timestamp && data.signupDate <= request.time &&
        data.lastLoginAt is timestamp && data.lastLoginAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatSession(data, ownerUid) {
      return data.userId is string && data.userId == ownerUid &&
        isValidPersonaId(data.personaId) &&
        data.personaName is string && data.personaName.size() >= 1 && data.personaName.size() <= 60 &&
        data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
        data.messageCount is int && data.messageCount >= 0 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, ownerUid, sessionId) {
      return data.userId is string && data.userId == ownerUid &&
        data.sessionId is string && data.sessionId == sessionId &&
        isValidPersonaId(data.personaId) &&
        data.sender in ['user', 'model'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
        data.inputMode in ['text', 'voice'] &&
        data.groundingSources is list && data.groundingSources.size() <= 10 &&
        (data.groundingSources.size() == 0 || data.groundingSources[0] is string) &&
        data.flagged is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidModerationItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        isValidPersonaId(data.personaId) &&
        isValidId(data.sessionId) &&
        data.messageText is string && data.messageText.size() >= 1 && data.messageText.size() <= 8000 &&
        data.matchedKeywords is list && data.matchedKeywords.size() >= 1 && data.matchedKeywords.size() <= 20 &&
        data.matchedKeywords[0] is string &&
        data.severity in ['medium', 'high'] &&
        data.status in ['pending', 'reviewed', 'dismissed'] &&
        data.reviewedBy is string && data.reviewedBy.size() <= 200 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll([
          'userId', 'email', 'name', 'dateOfBirth', 'age', 'isAdult',
          'currentActivity', 'studyField', 'hobbies', 'passwordHash', 'passwordSalt',
          'termsAccepted', 'profileCompleted', 'messageCount',
          'signupDate', 'lastLoginAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'email', 'name', 'dateOfBirth', 'age', 'isAdult',
          'currentActivity', 'studyField', 'hobbies', 'passwordHash', 'passwordSalt',
          'termsAccepted', 'profileCompleted', 'messageCount',
          'signupDate', 'lastLoginAt', 'updatedAt'
        ]) &&
        incoming().messageCount == 0 &&
        isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().signupDate == existing().signupDate && (
          isAdmin() || (
            request.auth.uid == userId && (
              // Action 1: Profile or encrypted password update
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'name', 'dateOfBirth', 'age', 'isAdult',
                'currentActivity', 'studyField', 'hobbies',
                'passwordHash', 'passwordSalt', 'termsAccepted',
                'profileCompleted', 'lastLoginAt', 'updatedAt'
              ]) ||
              // Action 2: Login timestamp refresh
              incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt']) ||
              // Action 3: Increment user messageCount by 1
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt']) &&
                incoming().messageCount == existing().messageCount + 1
              )
            )
          )
        );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

      match /sessions/{sessionId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          request.auth.uid == userId &&
          incoming().keys().hasAll([
            'userId', 'personaId', 'personaName', 'lastMessagePreview',
            'messageCount', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'personaId', 'personaName', 'lastMessagePreview',
            'messageCount', 'createdAt', 'updatedAt'
          ]) &&
          incoming().messageCount == 0 &&
          isValidChatSession(incoming(), userId) &&
          (
            incoming().personaId != 'partner' ||
            get(/databases/$(database)/documents/users/$(userId)).data.isAdult == true
          );

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          request.auth.uid == userId &&
          isValidChatSession(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().personaId == existing().personaId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastMessagePreview', 'messageCount', 'updatedAt'
          ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) &&
          (request.auth.uid == userId || isAdmin());

        match /messages/{messageId} {
          allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

          allow create: if isSignedIn() &&
            isValidId(userId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            request.auth.uid == userId &&
            incoming().keys().hasAll([
              'userId', 'sessionId', 'personaId', 'sender', 'text',
              'inputMode', 'groundingSources', 'flagged', 'createdAt'
            ]) &&
            incoming().keys().hasOnly([
              'userId', 'sessionId', 'personaId', 'sender', 'text',
              'inputMode', 'groundingSources', 'flagged', 'createdAt'
            ]) &&
            isValidChatMessage(incoming(), userId, sessionId) &&
            (
              exists(/databases/$(database)/documents/users/$(userId)/sessions/$(sessionId)) ||
              existsAfter(/databases/$(database)/documents/users/$(userId)/sessions/$(sessionId))
            );

          allow update, delete: if isAdmin();
        }
      }
    }

    match /moderationQueue/{flagId} {
      allow get, list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(flagId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().reviewedBy == '' &&
        incoming().keys().hasAll([
          'userId', 'userEmail', 'userName', 'personaId', 'sessionId',
          'messageText', 'matchedKeywords', 'severity', 'status',
          'reviewedBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'userEmail', 'userName', 'personaId', 'sessionId',
          'messageText', 'matchedKeywords', 'severity', 'status',
          'reviewedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidModerationItem(incoming());

      allow update: if isAdmin() &&
        isValidId(flagId) &&
        isValidModerationItem(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }
  }
}
